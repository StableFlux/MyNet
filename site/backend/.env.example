# MyNet — Environment Configuration
# Copy this file to .env and fill in the values.
# .env is never committed to version control.

# ── Database ────────────────────────────────────────────────────────────────
# Path to the SQLite database file. Defaults to mynet.db in the backend directory.
# DB_PATH=/data/mynet.db

# ── Security ────────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens. REQUIRED for persistent sessions.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If not set, a key is auto-generated and written to .env on first startup.
JWT_SECRET_KEY=

# JWT token expiry in minutes. Default: 480 (8 hours).
# JWT_EXPIRE_MINUTES=480

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for browser requests.
# If not set, all private-network IP ranges are allowed (suitable for LAN use).
# Set this when exposing MyNet beyond your local network.
# Example: CORS_ORIGINS=https://mynet.example.com,http://192.168.1.100
# CORS_ORIGINS=

# ── PiHole Integration (optional) ───────────────────────────────────────────
# Leave blank to disable PiHole integration.
# PIHOLE1_URL=http://192.168.1.2
# PIHOLE2_URL=
# PIHOLE_POLL_INTERVAL_SECS=300

# ── Monitoring ──────────────────────────────────────────────────────────────
# MONITORING_MAX_CONCURRENT_PINGS=20
# MONITORING_DEFAULT_INTERVAL_SECS=60
# MONITORING_FAILURE_THRESHOLD=3

# ── QR / Label printing ─────────────────────────────────────────────────────
# Label dimensions in pixels for Brother P950NW 24mm tape at 300dpi.
# QR_LABEL_WIDTH_PX=696
# QR_LABEL_HEIGHT_PX=272
