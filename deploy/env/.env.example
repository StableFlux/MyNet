# MyNet — production environment variables
# Copy this file to .env and fill in the values before first run.

# REQUIRED — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# The URL your instance is accessible at (used for CORS and QR code generation)
# Examples: http://192.168.1.10  |  http://mynet.local  |  https://mynet.example.com
APP_URL=http://localhost

# Port to bind on the host (default: 80)
# PORT=8080

# Optional: Pi-hole integration — leave blank to disable
# PIHOLE1_URL=http://192.168.1.2
# PIHOLE2_URL=http://192.168.1.3
