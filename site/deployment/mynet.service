[Unit]
Description=MyNet Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/mynet/backend
ExecStart=/opt/mynet/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/mynet/.env

[Install]
WantedBy=multi-user.target
