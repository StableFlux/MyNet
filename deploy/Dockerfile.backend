FROM python:3.12-slim

WORKDIR /app

# System deps: libffi for cryptography, fonts-dejavu for QR label generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    libffi-dev \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY site/backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY site/backend/ .

EXPOSE 8000

# Single worker — SQLite does not support concurrent writers safely.
# If you migrate to PostgreSQL, you can increase workers here.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
