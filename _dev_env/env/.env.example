# Copy this to .env and fill in values before first run.
# dev.ps1 does this automatically on first run.

# Required: generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# The URL your instance is accessible at (used for CORS and QR codes)
APP_URL=http://localhost

# Optional: Pi-hole integration — leave blank to disable
# PIHOLE1_URL=http://192.168.1.2
# PIHOLE2_URL=http://192.168.1.3
